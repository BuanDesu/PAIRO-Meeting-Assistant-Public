{
  "name": "p2p-meeting-copilot",
  "version": "0.3.0",
  "private": true,
  "description": "PAIRO meeting assistant connecting Windows and Android over WebRTC",
  "author": "BuanDesu",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "signal": "node server/signaling.js",
    "desktop": "npm run build && electron .",
    "desktop:portable": "npm run build && node scripts/build-desktop.mjs",
    "android:sync": "npm run build && node scripts/prepare-android.mjs",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "android:release": "npm run android:sync && node scripts/build-android.mjs --release",
    "release:check": "node scripts/release-version.mjs",
    "test": "node --test",
    "test:desktop": "node scripts/run-desktop-smoke.mjs --permissions-only",
    "test:webrtc": "node scripts/run-desktop-smoke.mjs",
    "test:ui": "npm run build && node scripts/run-workspace-smoke.mjs",
    "test:ui:media": "npm run build && node scripts/run-ui-smoke.mjs",
    "test:native-workspace": "npm run build && node scripts/run-native-workspace-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.2",
    "opencc-js": "1.4.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.3",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "com.pairo.meetingcopilot",
    "productName": "Pairo Meeting Copilot",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "src/protocol.js",
      "src/shortcuts.js",
      "package.json",
      "!node_modules/@capacitor/**/*",
      "!node_modules/html5-qrcode/**/*",
      "!node_modules/qrcode/**/*",
      "!node_modules/!(ws|opencc-js)/**/*"
    ],
    "win": {
      "signExecutable": false
    }
  }
}
