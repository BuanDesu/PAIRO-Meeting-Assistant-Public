{
  "name": "p2p-meeting-copilot",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "signal": "node server/signaling.js",
    "desktop": "npm run build && electron .",
    "desktop:portable": "npm run build && node scripts/build-desktop.mjs",
    "android:sync": "npm run build && node scripts/prepare-android.mjs",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "test": "node --test",
    "test:desktop": "node scripts/run-desktop-smoke.mjs --permissions-only",
    "test:webrtc": "node scripts/run-desktop-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.3",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "xcode": { "uuid": "^11.1.1" }
  },
  "build": {
    "appId": "com.pairo.meetingcopilot",
    "productName": "Pairo Meeting Copilot",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false
    }
  }
}
